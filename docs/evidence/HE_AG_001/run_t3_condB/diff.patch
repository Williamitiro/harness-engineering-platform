+    def calculate_discount(
+        self,
+        subtotal: float,
+        promo_code: Optional[str] = None,
+        customer_tier: Optional[str] = None,
+    ) -> float:
+        discount = 0.0
+
+        if promo_code in self.PROMO_RATES:
+            discount += subtotal * self.PROMO_RATES[promo_code]
+        elif promo_code == "FIXED15":
+            discount += min(15.0, subtotal)
+
+        if customer_tier in self.TIER_RATES:
