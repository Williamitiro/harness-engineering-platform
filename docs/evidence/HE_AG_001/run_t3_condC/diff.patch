+    """
+
+    DEFAULT_TAX_RATES = {
+        "CA": 0.085,
+        "NY": 0.080,
+        "TX": 0.0625,
+    }
+
+    def __init__(self, state: str = "CA", custom_rates: Optional[Dict[str, float]] = None):
+        self.state = state
+        self.tax_rates = custom_rates if custom_rates is not None else self.DEFAULT_TAX_RATES
+
+    def calculate_tax(self, taxable_amount: float, state: Optional[str] = None) -> float:
+        """
+        Calculate tax on taxable amount for a given state (or default state).
+        """
+        st = state if state is not None else self.state
+        rate = self.tax_rates.get(st, 0.05)
+        return round(taxable_amount * rate, 2)
