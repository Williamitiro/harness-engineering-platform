+class DiscountPolicy:
+    """
+    Handles calculation of promotional and customer-tier discounts.
+    """
+
+    def __init__(self, promo_code: Optional[str] = None, customer_tier: Optional[str] = None):
+        self.promo_code = promo_code
+        self.customer_tier = customer_tier
+
+    def calculate_discount(self, subtotal: float) -> float:
+        """
+        Calculate total discount given the subtotal.
+        """
+        discount = 0.0
+        if self.promo_code == "SUMMER10":
+            discount += subtotal * 0.10
+        elif self.promo_code == "SAVE20":
+            discount += subtotal * 0.20
+        elif self.promo_code == "FIXED15":
+            discount += min(15.0, subtotal)
+
+        if self.customer_tier == "gold":
+            discount += (subtotal - discount) * 0.05
+        elif self.customer_tier == "platinum":
+            discount += (subtotal - discount) * 0.10
+
+        return round(min(discount, subtotal), 2)
+
+
+class ShippingCalculator:
+    """
+    Handles calculation of shipping costs based on weight, shipping method, and customer tier/subtotal.
+    """
+
+    def __init__(
+        self,
+        weight_kg: float = 1.0,
+        method: str = "standard",
+        customer_tier: Optional[str] = None,
+        discounted_subtotal: float = 0.0,
+    ):
+        self.weight_kg = weight_kg
+        self.method = method
+        self.customer_tier = customer_tier
+        self.discounted_subtotal = discounted_subtotal
+
+    def calculate_shipping(
+        self,
+        weight_kg: Optional[float] = None,
+        method: Optional[str] = None,
+        customer_tier: Optional[str] = None,
+        discounted_subtotal: Optional[float] = None,
+    ) -> float:
+        """
+        Calculate shipping cost. Parameters can be overridden if provided.
+        """
+        weight = self.weight_kg if weight_kg is None else weight_kg
+        shipping_method = self.method if method is None else method
+        tier = self.customer_tier if customer_tier is None else customer_tier
+        subtotal = self.discounted_subtotal if discounted_subtotal is None else discounted_subtotal
+
+        if weight <= 2.0:
+            base_shipping = 5.0
+        elif weight <= 5.0:
+            base_shipping = 10.0
+        else:
+            base_shipping = 15.0 + (weight - 5.0) * 1.0
+
+        if shipping_method == "express":
+            shipping_cost = base_shipping + 8.0
+        else:
+            shipping_cost = base_shipping
+
+        # VIP shipping rules: platinum tier or discounted_subtotal > 100 gets free standard shipping or $4 express discount
+        if tier == "platinum" or subtotal > 100.0:
+            if shipping_method == "standard":
+                shipping_cost = 0.0
+            elif shipping_method == "express":
+                shipping_cost = max(0.0, shipping_cost - 4.0)
+
+        return round(shipping_cost, 2)
+
+
+class TaxCalculator:
+    """
